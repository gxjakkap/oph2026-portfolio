{
  "name": "portfolio-oph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pdfjs": "cp -r node_modules/pdfjs-dist/cmaps node_modules/pdfjs-dist/standard_fonts node_modules/pdfjs-dist/wasm public/",
    "dev": "bun run pdfjs && vite",
    "build": "bun run pdfjs && tsc -b && vite build",
    "preview": "bun run build && vite preview",
    "lint": "oxlint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply oph2026-portfolio --local",
    "seed": "bun scripts/seed.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
